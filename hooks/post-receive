#!/bin/bash
# docsite 的 git post-receive 钩子：push 即部署（部署选项 A）。
# 把 main 检出到文档目录，然后跑 build.py 重建首页/分类/归档/搜索索引。
#
# 路径通过环境变量配置（部署时在系统/unit 环境里设，或改默认值）：
#   DOCSITE_REPO    bare 仓库路径      默认 /srv/docsite-content.git
#   DOCSITE_WORK    文档检出目录        默认 /srv/docsite/site/docs
#   DOCSITE_ROOT    build.py 所在目录   默认 /srv/docsite
set -eo pipefail
export HOME="${HOME:-$PWD}"
REPO="${DOCSITE_REPO:-/srv/docsite-content.git}"
WORK="${DOCSITE_WORK:-/srv/docsite/site/docs}"
DOCSITE_ROOT="${DOCSITE_ROOT:-/srv/docsite}"

echo "[docsite post-receive] deploying..."
# Hold one repository lock through target resolution, validation, checkout and build.
exec python3 -c '
import fcntl
import os
import subprocess
import sys

# Create a group-writable lock for the documented --shared=group repository.
original_umask = os.umask(0o007)
with open(sys.argv[1] + "/docsite-deploy.lock", "a") as lock:
    os.umask(original_umask)
    fcntl.flock(lock, fcntl.LOCK_EX)
    sys.exit(subprocess.run(["bash", "-s", "--", *sys.argv[1:]]).returncode)
' "$REPO" "$WORK" "$DOCSITE_ROOT" <<'DEPLOY'
set -eo pipefail
REPO="$1"
WORK="$2"
DOCSITE_ROOT="$3"

TARGET="$(git --git-dir="$REPO" rev-parse refs/heads/main)"
# Refuse symlinks before checkout: a failed build cannot hide a link already served.
git --git-dir="$REPO" ls-tree -r -z "$TARGET" | python3 -c '
import os
import sys
for entry in sys.stdin.buffer.read().split(b"\0"):
    if entry.startswith(b"120000 "):
        name = os.fsdecode(entry.split(b"\t", 1)[1])
        sys.exit(f"[docsite post-receive] content symlink is not allowed: {name!r}")
'
# 检出刚验证的树，覆盖并同步删除；保留 bare 仓库的 HEAD 指向 main。
git --git-dir="$REPO" --work-tree="$WORK" read-tree --reset -u "$TARGET"
git --git-dir="$REPO" symbolic-ref HEAD refs/heads/main

# 重建索引；失败则非零退出，让 push 方看到部署失败（不静默吞错）
cd "$DOCSITE_ROOT"
if python3 build.py >> "$DOCSITE_ROOT/build.log" 2>&1; then
  echo "[docsite post-receive] build ok, docs: $(find "$WORK" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)"
else
  echo "[docsite post-receive] build FAILED (see $DOCSITE_ROOT/build.log)"
  exit 1
fi
DEPLOY
